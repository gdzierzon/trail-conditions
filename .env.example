# Copy this file to .env, then put your own Atlas connection string in place of the one below: your database
# user's name and password, and your cluster's address, from Atlas's Connect screen.
# .env stays on your computer: .gitignore leaves it out of Git, because a password never goes on GitHub.
# PORT isn't here: on your computer the API uses 3100, and Render sets PORT itself.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>/?retryWrites=true&w=majority
